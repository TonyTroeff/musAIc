{
  "name": "musaic-frontend",
  "version": "1.0.0",
  "description": "musAIc frontend - React SPA",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress/tsconfig.json",
    "cy:open": "cypress open --component",
    "cy:run:component": "cypress run --component"
  },
  "dependencies": {
    "@clerk/react": "^6.17.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
